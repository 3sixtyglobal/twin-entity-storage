{
	"language": "en-GB",
	"ignorePaths": [
		"**/node_modules/**",
		"LICENSE",
		"**/coverage/**",
		"**/dist/**",
		"**/docs/reference/**",
		"**/docs/open-api/**",
		"**/tests/**",
		"*.yaml",
		"package.json",
		"vitest.config.*",
		"tsconfig.json",
		"tsconfig.eslint.json",
		"typedoc.json",
		"eslint.config*",
		"**/wordlists/**",
		"changelog.md"
	],
	"words": [
		"abbrev",
		"amname",
		"attname",
		"attnum",
		"attrelid",
		"autorelease",
		"bavail",
		"cloudsdktool",
		"conds",
		"cosmosdb",
		"datname",
		"elem",
		"Firestore",
		"hotfixes",
		"ILIKE",
		"indexrelid",
		"indisready",
		"indisunique",
		"indisvalid",
		"indkey",
		"indnkeyatts",
		"indpred",
		"indrelid",
		"iotaledger",
		"LONGTEXT",
		"nameof",
		"nspname",
		"regclass",
		"relam",
		"relname",
		"relnamespace",
		"scylladb",
		"statfs",
		"Stiftung",
		"teardown",
		"TINYINT",
		"unmarshall",
		"upserted",
		"upserts"
	],
	"ignoreRegExpList": [
		"/from\\s+(['\"]).*\\1/",
		"/eslint-disable.*/",
		"/^```typescript[\\s\\S]*?```$/gm",
		"/^```shell[\\s\\S]*?```$/gm",
		"/^```json[\\s\\S]*?```$/gm"
	]
}
