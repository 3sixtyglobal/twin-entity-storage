{
	"name": "@twin.org/entity-storage-service",
	"version": "0.10.1-next.11",
	"description": "Service layer exposing storage contracts and REST endpoint definitions.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/iotaledger/twin-entity-storage.git",
		"directory": "packages/entity-storage-service"
	},
	"author": "martyn.janes@iota.org",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"clean": "rimraf dist coverage",
		"build": "tspc",
		"dev": "nodemon --watch src --ext ts --exec \"pnpm run build\"",
		"test": "vitest --run --config ./vitest.config.ts --no-cache",
		"test:coverage": "vitest --run --coverage --config ./vitest.config.ts --no-cache",
		"test:build": "tspc -p ./tests/tsconfig.json --noEmit",
		"validate-locales": "validate-locales",
		"docs:clean": "rimraf docs/reference",
		"docs:generate": "typedoc --options typedoc.config.mjs",
		"docs:api": "ts-to-openapi ./ts-to-openapi.json ./docs/open-api/spec.json",
		"docs": "pnpm run docs:clean && pnpm run docs:generate && pnpm run docs:api",
		"dist": "pnpm run clean && concurrently -g -n build,locales,types,test \"pnpm run build\" \"pnpm run validate-locales\" \"pnpm run test:build\" \"pnpm run test\"",
		"dist:no-test": "pnpm run clean && concurrently -g -n build,locales,types \"pnpm run build\" \"pnpm run validate-locales\" \"pnpm run test:build\""
	},
	"dependencies": {
		"@twin.org/api-models": "next",
		"@twin.org/context": "next",
		"@twin.org/core": "next",
		"@twin.org/entity": "next",
		"@twin.org/entity-storage-models": "0.10.1-next.11",
		"@twin.org/logging-models": "next",
		"@twin.org/nameof": "next",
		"@twin.org/web": "next"
	},
	"devDependencies": {
		"@twin.org/entity-storage-connector-memory": "0.10.1-next.11",
		"@twin.org/nameof-transformer": "next",
		"@twin.org/nameof-vitest-plugin": "next",
		"@twin.org/ts-to-openapi": "next",
		"@twin.org/validate-locales": "next",
		"@vitest/coverage-v8": "5.0.1",
		"concurrently": "10.0.5",
		"copyfiles": "2.4.1",
		"nodemon": "3.1.14",
		"rimraf": "6.1.3",
		"ts-patch": "4.0.1",
		"typedoc": "0.28.20",
		"typedoc-plugin-markdown": "4.13.1",
		"typescript": "6.0.3",
		"vitest": "5.0.1"
	},
	"main": "./dist/es/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/es/index.js",
			"default": "./dist/es/index.js"
		},
		"./locales/*.json": "./locales/*.json"
	},
	"files": [
		"dist/es",
		"dist/types",
		"locales",
		"docs"
	],
	"keywords": [
		"twin",
		"trade",
		"iota",
		"framework",
		"blockchain",
		"entity-storage",
		"entity",
		"storage",
		"persistence",
		"database",
		"service",
		"microservice",
		"business-logic"
	],
	"bugs": {
		"url": "git+https://github.com/iotaledger/twin-entity-storage/issues"
	},
	"homepage": "https://twindev.org"
}
