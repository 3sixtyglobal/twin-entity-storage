{
	"name": "@twin.org/entity-storage-connector-mysql",
	"version": "0.11.0",
	"description": "MySQL connector for relational persistence with SQL querying.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/iotaledger/twin-entity-storage.git",
		"directory": "packages/entity-storage-connector-mysql"
	},
	"author": "adrian.sanchez.sequeira@iota.org",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"clean": "rimraf dist coverage",
		"build": "tspc",
		"dev": "nodemon --watch src --ext ts --exec \"pnpm run build\"",
		"test": "vitest --run --config ./vitest.config.ts --no-cache",
		"test:coverage": "vitest --run --coverage --config ./vitest.config.ts --no-cache",
		"test:build": "tspc -p ./tests/tsconfig.json --noEmit",
		"validate-locales": "validate-locales",
		"docs:clean": "rimraf docs/reference",
		"docs:generate": "typedoc --options typedoc.config.mjs",
		"docs": "pnpm run docs:clean && pnpm run docs:generate",
		"dist": "pnpm run clean && concurrently -g -n build,locales,types,test \"pnpm run build\" \"pnpm run validate-locales\" \"pnpm run test:build\" \"pnpm run test\"",
		"dist:no-test": "pnpm run clean && concurrently -g -n build,locales,types \"pnpm run build\" \"pnpm run validate-locales\" \"pnpm run test:build\""
	},
	"dependencies": {
		"@twin.org/api-models": "^0.10.0",
		"@twin.org/context": "^0.11.0",
		"@twin.org/core": "^0.11.0",
		"@twin.org/data-json-ld": "^0.11.0",
		"@twin.org/entity": "^0.11.0",
		"@twin.org/entity-storage-models": "^0.11.0",
		"@twin.org/logging-models": "^0.10.0",
		"@twin.org/nameof": "^0.11.0",
		"mysql2": "3.24.4"
	},
	"devDependencies": {
		"@twin.org/entity-storage-connector-memory": "^0.11.0",
		"@twin.org/logging-connector-entity-storage": "^0.10.0",
		"@twin.org/logging-service": "^0.10.0",
		"@twin.org/nameof-transformer": "^0.11.0",
		"@twin.org/nameof-vitest-plugin": "^0.11.0",
		"@twin.org/validate-locales": "^0.11.0",
		"@types/node": "26.6.2",
		"@vitest/coverage-v8": "5.0.1",
		"concurrently": "10.0.5",
		"copyfiles": "2.4.1",
		"dotenv": "18.0.2",
		"nodemon": "3.1.14",
		"rimraf": "6.1.3",
		"ts-patch": "4.0.1",
		"typedoc": "0.28.20",
		"typedoc-plugin-markdown": "4.13.1",
		"typescript": "6.0.3",
		"vitest": "5.0.1"
	},
	"main": "./dist/es/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/es/index.js",
			"default": "./dist/es/index.js"
		},
		"./locales/*.json": "./locales/*.json"
	},
	"files": [
		"dist/es",
		"dist/types",
		"locales",
		"docs"
	],
	"keywords": [
		"twin",
		"trade",
		"iota",
		"framework",
		"blockchain",
		"entity-storage",
		"entity",
		"storage",
		"persistence",
		"database",
		"connector",
		"adapter",
		"integration"
	],
	"bugs": {
		"url": "git+https://github.com/iotaledger/twin-entity-storage/issues"
	},
	"homepage": "https://twindev.org"
}
