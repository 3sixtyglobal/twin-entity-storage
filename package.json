{
	"name": "@twin.org/entity-storage",
	"version": "0.0.0",
	"description": "Entity Storage",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/twinfoundation/entity-storage.git"
	},
	"author": "martyn.janes@iota.org",
	"license": "Apache-2.0",
	"private": true,
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"build": "node ./scripts/workspaces.mjs build",
		"dist": "node ./scripts/workspaces.mjs dist",
		"dist:no-test": "node ./scripts/workspaces.mjs dist:no-test",
		"format": "prettier --config .prettierrc --write .",
		"lint:format": "prettier --config .prettierrc --check .",
		"lint:code": "eslint . --cache --cache-location .eslintcache",
		"lint:markdown": "markdownlint **/*.md --ignore **/node_modules/** --ignore **/docs/reference/**  --ignore **/changelog.md",
		"lint:spell": "cspell ** --no-progress",
		"lint": "npm run lint:format && npm run lint:code && npm run lint:markdown && npm run lint:spell",
		"local-link": "node ./scripts/local-link.mjs",
		"commitlint": "commitlint --edit",
		"generate-release-configs": "node scripts/generate-release-configs.mjs release",
		"prepare": "husky"
	},
	"devDependencies": {
		"@commitlint/cli": "20.1.0",
		"@commitlint/config-conventional": "20.0.0",
		"@eslint/eslintrc": "3.3.1",
		"@eslint/js": "9.39.1",
		"@stylistic/eslint-plugin": "5.5.0",
		"@typescript-eslint/eslint-plugin": "8.46.3",
		"cspell": "9.3.0",
		"eslint": "9.39.1",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-header": "3.1.1",
		"eslint-plugin-import": "2.32.0",
		"eslint-plugin-jsdoc": "61.1.12",
		"eslint-plugin-prettier": "5.5.4",
		"eslint-plugin-promise": "7.2.1",
		"eslint-plugin-simple-import-sort": "12.1.1",
		"eslint-plugin-unicorn": "62.0.0",
		"eslint-plugin-unused-imports": "4.3.0",
		"globals": "16.5.0",
		"husky": "9.1.7",
		"markdownlint-cli": "0.45.0",
		"prettier": "3.6.2",
		"release-please": "17.1.3"
	},
	"workspaces": [
		"packages/entity-storage-models",
		"packages/entity-storage-connector-memory",
		"packages/entity-storage-service",
		"packages/entity-storage-rest-client",
		"packages/entity-storage-connector-file",
		"packages/entity-storage-connector-scylladb",
		"packages/entity-storage-connector-dynamodb",
		"packages/entity-storage-connector-gcp-firestore",
		"packages/entity-storage-connector-mysql",
		"packages/entity-storage-connector-mongodb",
		"packages/entity-storage-connector-postgresql",
		"packages/entity-storage-connector-cosmosdb"
	],
	"type": "module",
	"bugs": {
		"url": "git+https://github.com/twinfoundation/entity-storage/issues"
	},
	"homepage": "https://twindev.org"
}
