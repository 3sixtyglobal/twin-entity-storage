{
	"name": "@twin.org/entity-storage",
	"version": "0.0.0",
	"description": "Unified packages for modelling, serving and connecting entity storage across multiple backends.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/iotaledger/entity-storage.git"
	},
	"author": "martyn.janes@iota.org",
	"license": "Apache-2.0",
	"private": true,
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"build": "node ./scripts/workspaces.mjs build",
		"dist": "node ./scripts/workspaces.mjs dist",
		"dist:no-test": "node ./scripts/workspaces.mjs dist:no-test",
		"test": "node ./scripts/workspaces.mjs test",
		"format": "prettier --config prettier.config.mjs --write .",
		"lint:format": "prettier --config prettier.config.mjs --check .",
		"lint:code": "eslint . --cache --cache-location .eslintcache",
		"lint:markdown": "markdownlint **/*.md --ignore **/node_modules/** --ignore **/docs/reference/**  --ignore **/changelog.md",
		"lint:spell": "cspell ** --no-progress",
		"lint": "npm run lint:format && npm run lint:code && npm run lint:markdown && npm run lint:spell",
		"docs": "node ./scripts/workspaces.mjs docs",
		"local-link": "node ./scripts/local-link.mjs",
		"commitlint": "commitlint --edit",
		"generate-release-configs": "node scripts/generate-release-configs.mjs release",
		"prepare": "husky"
	},
	"devDependencies": {
		"@commitlint/cli": "21.0.1",
		"@commitlint/config-conventional": "21.0.1",
		"@eslint/eslintrc": "3.3.5",
		"@eslint/js": "10.0.1",
		"@stylistic/eslint-plugin": "5.10.0",
		"@typescript-eslint/eslint-plugin": "8.59.4",
		"cspell": "10.0.0",
		"eslint": "10.4.0",
		"eslint-config-prettier": "10.1.8",
		"@tony.ganchev/eslint-plugin-header": "3.4.4",
		"eslint-plugin-import-x": "4.16.2",
		"eslint-plugin-jsdoc": "62.9.0",
		"eslint-plugin-prettier": "5.5.5",
		"eslint-plugin-promise": "7.3.0",
		"eslint-plugin-simple-import-sort": "13.0.0",
		"eslint-plugin-unicorn": "64.0.0",
		"eslint-plugin-unused-imports": "4.4.1",
		"globals": "17.6.0",
		"husky": "9.1.7",
		"markdownlint-cli": "0.48.0",
		"prettier": "3.8.3",
		"release-please": "17.6.0"
	},
	"workspaces": [
		"packages/entity-storage-models",
		"packages/entity-storage-connector-memory",
		"packages/entity-storage-service",
		"packages/entity-storage-rest-client",
		"packages/entity-storage-connector-file",
		"packages/entity-storage-connector-scylladb",
		"packages/entity-storage-connector-gcp-firestore",
		"packages/entity-storage-connector-mysql",
		"packages/entity-storage-connector-mongodb",
		"packages/entity-storage-connector-postgresql",
		"packages/entity-storage-connector-cosmosdb",
		"packages/entity-storage-connector-dynamodb"
	],
	"type": "module",
	"bugs": {
		"url": "git+https://github.com/iotaledger/entity-storage/issues"
	},
	"homepage": "https://twindev.org"
}
